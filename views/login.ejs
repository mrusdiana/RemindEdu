<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log in — RemindEdu</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/login.css">
</head>

<body>

  <div class="login-page">

    <section class="login-hero">
      <div class="login-hero__decor login-hero__decor--one"></div>
      <div class="login-hero__decor login-hero__decor--two"></div>

      <div class="login-hero__content">
        <div class="brand">
          <span class="brand__mark">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3z" fill="#fff"/>
              <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" fill="#fff"/>
            </svg>
          </span>
          <span class="brand__name">RemindEdu</span>
        </div>

        <div class="hero">
          <h1 class="login-hero__title">Your academic</h1>
          <h1 class="login-hero__title">life, organised.</h1>
          <p class="login-hero__subtitle">
            Deadlines, tasks, and study connections —
          </p>
          <p class="login-hero__subtitle">
            all in one clean dashboard built for
          </p>
          <p class="login-hero__subtitle">
            university students.
          </p>
        </div>

        <ul class="login-hero__features">
          <li><span class="check">✓</span> Interactive deadline calendar</li>
          <li><span class="check">✓</span> Course-tagged task lists</li>
          <li><span class="check">✓</span> Student social feed with hashtags</li>
          <li><span class="check">✓</span> Study group discovery</li>
        </ul>

        <div class="testimonial">
          <div class="testimonial__stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p class="testimonial__quote">"RemindEdu is the only app that actually keeps up with my semester schedule."</p>
          <div class="testimonial__author">
            <span class="testimonial__avatar">TC</span>
            <div>
              <div class="testimonial__name">Tanya C.</div>
              <div class="testimonial__role">Medicine, Year 2</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="login-form-panel">

      <div class="login-form">
        <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <% error.split(',').forEach(msg => { %>
          <div><%= msg %></div>
          <% }) %>
        </div>
        <% } %>

        <h2 class="login-form__title">Welcome back</h2>
        <p class="login-form__subtitle">Log in to access your dashboard, tasks, and feed.</p>

        <form action="/login" method="post" novalidate>
          <div class="field">
            <label for="email">University Email</label>
            <input type="email" id="email" name="email" placeholder="you@university.edu" autocomplete="username"
              required>
          </div>

          <div class="field">
            <div class="field__label-row">
              <label for="password">Password</label>
              <a href="#" class="link-inline">Forgot password?</a>
            </div>
            <div class="password-input">
              <input type="password" id="password" name="password" placeholder="Enter your password"
                autocomplete="current-password" required>
              <button type="button" class="password-toggle" aria-label="Show password">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </button>
            </div>
          </div>

          <label class="checkbox-row">
            <input type="checkbox" name="keep-logged-in">
            <span>Keep me logged in</span>
          </label>

          <button type="submit" class="btn-primary">Log in <span class="arrow">→</span></button>

          <div class="divider"><span>or continue with</span></div>

          <div class="oauth-row">
            <a href="/login/google" class="btn-oauth">
              <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
              Google
            </a>
          </div>

          <p class="signup-line">Don't have an account? <a href="/register" class="link-inline link-inline--bold">Sign up
              free</a></p>
        </form>
      </div>

      <p class="terms-line">By continuing, you agree to our <a href="/terms" class="link-inline">Terms</a> and
        <a href="/privacy" class="link-inline">Privacy Policy</a>.</p>
    </section>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>

  <script>
    const toggle = document.querySelector('.password-toggle');
    const passwordInput = document.getElementById('password');
    if (toggle && passwordInput) {
      toggle.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
      });
    }
  </script>
</body>

</html>