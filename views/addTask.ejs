<!-- views/addTask.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Task</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/addTask.css">
</head>
<body>

  <div class="modal fade show" id="addTaskModal" tabindex="-1" aria-hidden="true" style="display: block; background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-sm rounded-4 p-4">
        
        <div class="d-flex justify-content-between align-items-center mb-1">
          <h5 class="fw-bold mb-0">New Task</h5>
          <a href="/dashboard" type="button" class="btn-close shadow-none" aria-label="Close"></a>
        </div>
        <p class="text-muted small mb-4">Add a task to your list</p>
  
        <form action="/student/tasks/<%= id %>/add" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Task Title</label>
            <input type="text" name="title" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="e.g., Complete Chapter 5 exercises" required>
          </div>
  
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Course Name</label>
            <input type="text" name="courseName" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="e.g., MATH 201" required>
          </div>
  
          <div class="mb-4">
            <label class="form-label small fw-semibold text-secondary">Due Date</label>
            <input type="date" name="deadline" class="form-control form-control-lg bg-light border-0 fs-6" required>
          </div>
  
          <div class="d-flex gap-3">
            <a href="/student" class="btn btn-light w-50 py-2 fw-semibold border text-center text-decoration-none">Cancel</a>
            <button type="submit" class="btn btn-primary w-50 py-2 fw-semibold">Add Task</button>
          </div>
        </form>
  
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>