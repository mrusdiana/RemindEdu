<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Feed — RemindEdu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #F5F7FA; }
    .brand-icon { background: #1E40AF; color: #fff; border-radius: 10px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .brand-text  { font-weight: 800; font-size: 1.1rem; }
    .text-primary-brand { color: #3B82F6; }
    .nav-pill-item { display: flex; align-items: center; gap: 6px; padding: 6px 16px; border-radius: 999px; font-size: .875rem; font-weight: 500; color: #4B5563; text-decoration: none; transition: background .15s; }
    .nav-pill-item:hover { background: #F3F4F6; }
    .nav-pill-item.active { background: #EFF6FF; color: #2563EB; font-weight: 600; }

    .post-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.07); padding: 1.25rem 1.5rem; }
    .avatar-sm { width: 36px; height: 36px; border-radius: 50%; background: #EEF4FF; color: #3B82F6; font-size: .8rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .post-content { font-size: .95rem; color: #111827; line-height: 1.6; }
    .post-meta { font-size: .78rem; color: #9CA3AF; }
    .btn-add-post { background: #2563EB; color: #fff; border: none; border-radius: 10px; padding: 8px 18px; font-size: .875rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-add-post:hover { background: #1D4ED8; color: #fff; }
    .icon-action { background: #F3F4F6; border: none; border-radius: 8px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; color: #6B7280; font-size: .9rem; text-decoration: none; transition: background .15s; }
    .icon-action:hover { background: #EEF1F6; color: #111827; }
    .icon-action--danger:hover { background: #FEE2E2; color: #DC2626; }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2">
    <div class="container-fluid p-0">
      <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/">
        <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
      </a>
      <div class="d-none d-md-flex mx-auto gap-1">
        <a href="<%= basePath %>" class="nav-pill-item"><i class="bi bi-bar-chart"></i> Dashboard</a>
        <a href="<%= basePath %>/feeds" class="nav-pill-item active"><i class="bi bi-layers"></i> Social Feed</a>
        <% if (!isAdmin) { %>
        <a href="/student/profile" class="nav-pill-item"><i class="bi bi-journal-bookmark"></i> Profile</a>
        <% } %>
      </div>
      <div class="ms-auto ms-md-0">
        <a href="/logout" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <main class="container py-5" style="max-width: 680px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h4 class="fw-bold mb-1">Social Feed</h4>
        <p class="text-muted mb-0 small"><%= posts.length %> post tersedia</p>
      </div>
      <% if (!isAdmin) { %>
      <a href="/student/feeds/add" class="btn-add-post">
        <i class="bi bi-plus-lg"></i> Buat Post
      </a>
      <% } %>
    </div>

    <% if (posts.length === 0) { %>
    <div class="post-card text-center py-5 text-muted">
      <i class="bi bi-chat-square-text fs-2 d-block mb-2"></i>
      Belum ada post. Jadilah yang pertama!
    </div>
    <% } %>

    <% posts.forEach(post => { %>
    <div class="post-card mb-3">
      <div class="d-flex align-items-start gap-3">
        <span class="avatar-sm">
          <%= post.User && post.User.name ? post.User.name.slice(0,2).toUpperCase() : '??' %>
        </span>
        <div class="flex-grow-1">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="fw-semibold small"><%= post.User ? post.User.name : 'Unknown' %></span>
              <span class="post-meta ms-2">
                · <%= post.createdAt ? new Date(post.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %>
              </span>
            </div>
            <% if (post.userId === sessionUserId || isAdmin) { %>
            <div class="d-flex gap-1">
              <a href="<%= basePath %>/feeds/<%= post.id %>/edit" class="icon-action" title="Edit"><i class="bi bi-pencil"></i></a>
              <form method="POST" action="<%= basePath %>/feeds/<%= post.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus post ini?')">
                <button type="submit" class="icon-action icon-action--danger" title="Hapus"><i class="bi bi-trash"></i></button>
              </form>
            </div>
            <% } %>
          </div>
          <p class="post-content mt-2 mb-0"><%= post.content %></p>
        </div>
      </div>
    </div>
    <% }) %>
  </main>

</body>
</html>
