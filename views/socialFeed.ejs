<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Feed — RemindEdu</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <a href="/student/socialFeed" class="nav-pill-item active">
</head>

<body>

    <!-- Top navigation -->
    <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2">
        <div class="container-fluid p-0">

            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="#">
                <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
            </a>

            <!-- Center nav pills -->
            <div class="nav-pill-group d-none d-md-flex mx-auto">
                <a href="/student/dashboard" class="nav-pill-item">
                    <i class="bi bi-bar-chart"></i> Dashboard
                </a>
                <!-- Ubah href ke /socialFeed -->
                <a href="/socialFeed" class="nav-pill-item active">
                    <i class="bi bi-layers"></i> Social Feed
                </a>
                <!-- Ubah href ke /profile -->
                <a href="/profile" class="nav-pill-item">
                    <i class="bi bi-journal-bookmark"></i> Profile
                </a>
            </div>


            <!-- Right actions -->
            <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
                <button class="notif-btn" type="button" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notif-badge">3</span>
                </button>
                <span class="avatar-circle">JP</span>
            </div>

        </div>
    </nav>

    <!-- Page content -->
    <main class="container feed-container py-4 py-md-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-7">

                <div class="feed-header mb-3">
                    <h2 class="fw-bold mb-1">Social Feed</h2>
                    <p class="text-muted mb-0">Share notes, ask questions, connect with classmates</p>
                </div>

                <!-- Composer -->
                <div class="card composer-card border-0 shadow-sm mb-3">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex gap-3 mb-3">
                            <span class="avatar-circle avatar-circle--lg flex-shrink-0">JP</span>
                            <textarea class="form-control composer-input" rows="2"
                                placeholder="Share a study tip, ask a question, or post your notes..."></textarea>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn tool-btn"><i class="bi bi-hash"></i> Add tag</button>
                                <button type="button" class="btn tool-btn"><i class="bi bi-paperclip"></i> Attach
                                    notes</button>
                            </div>
                            <button type="button" class="btn btn-post">Post <i class="bi bi-send-fill"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Trending -->
                <div class="trending mb-4">
                    <span class="trending-label">TRENDING</span>
                    <a href="#" class="trending-tag">#Calculus</a>
                    <a href="#" class="trending-tag">#UAS</a>
                    <a href="#" class="trending-tag">#Statistics</a>
                    <a href="#" class="trending-tag">#LinearAlgebra</a>
                    <a href="#" class="trending-tag">#StudyTips</a>
                    <a href="#" class="trending-tag">#CS301</a>
                </div>

                <div class="d-flex flex-column gap-3">
                    <% post.forEach(element=> { %>
                        <article class="card post-card border-0 shadow-sm">
                            <div class="card-body p-3 p-md-4">

                                <!-- Header Post: Author & Meta -->
                                <div class="d-flex align-items-start gap-3 mb-2">

                                    <!-- Avatar Inisial Sederhana (Bebas Error) -->
                                    <span class="avatar-circle avatar-circle--purple flex-shrink-0">
                                        <% if (element.User && element.User.name) { %>
                                            <%= element.User.name.substring(0, 2).toUpperCase() %>
                                                <% } else { %>
                                                    U<%= element.userId %>
                                                        <% } %>
                                    </span>

                                    <div class="flex-grow-1">
                                        <!-- Menampilkan nama User -->
                                        <div class="post-author">
                                            <%= element.User ? element.User.name : 'User ' + element.userId %>
                                        </div>

                                        <!-- Format Tanggal Langsung Menggunakan .toDateString() -->
                                        <div class="post-submeta">
                                            <%= element.User ? element.User.role : 'Student' %> -
                                                <%= element.createdAt ? new Date(element.createdAt).toDateString() : ''
                                                    %>
                                        </div>
                                    </div>
                                    <button class="icon-btn" aria-label="Save post"><i
                                            class="bi bi-bookmark"></i></button>
                                </div>

                                <!-- Isi Konten Post -->
                                <p class="post-body mb-2">
                                    <%= element.content %>
                                </p>

                                <!-- Bagian Tag -->
                                <div class="post-tags mb-3">
                                    <span class="post-tag">#RemindEdu</span>
                                    <span class="post-tag">#SharingIsCaring</span>
                                </div>

                                <!-- Footer Post -->
                                <div class="post-footer d-flex gap-4">
                                    <button class="post-action"><i class="bi bi-heart"></i> 0 likes</button>
                                    <button class="post-action"><i class="bi bi-chat"></i> 0 replies</button>
                                </div>

                            </div>
                        </article>
                        <% }) %>
                </div>



            </div>
        </div>
    </main>

</body>

</html>