<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Feed — RemindEdu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/dashboard.css">
  <style>
    body { font-family: 'Inter', sans-serif; background: #F5F7FA; }

    /* Navbar */
    .brand-icon { background: #2F5EFF; color: #fff; border-radius: 10px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .brand-text  { font-weight: 800; font-size: 1.1rem; color: #111827; }
    .text-primary-brand { color: #3B82F6; }

    .nav-pill-group { background: #F3F4F6; border-radius: 999px; padding: 4px; display: flex; gap: 2px; }
    .nav-pill-item { display: flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 999px; font-size: .875rem; font-weight: 500; color: #4B5563; text-decoration: none; transition: background .15s; }
    .nav-pill-item:hover { background: #E5E7EB; color: #111827; }
    .nav-pill-item.active { background: #fff; color: #2563EB; font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.08); }

    .notif-btn { position: relative; background: none; border: none; color: #6B7280; font-size: 1.15rem; width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; transition: background .15s; }
    .notif-btn:hover { background: #F3F4F6; color: #111827; }
    .notif-badge { position: absolute; top: 2px; right: 2px; background: #F59E0B; color: #fff; font-size: .62rem; font-weight: 700; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    .avatar-circle { width: 36px; height: 36px; border-radius: 50%; background: #2563EB; color: #fff; font-size: .8rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }

    /* Header */
    .feed-title { font-size: 1.6rem; font-weight: 800; color: #111827; }
    .feed-subtitle { color: #9CA3AF; font-size: .9rem; }

    .btn-add-post { background: #2563EB; color: #fff; border: none; border-radius: 10px; padding: 10px 20px; font-size: .875rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: background .15s; }
    .btn-add-post:hover { background: #1D4ED8; color: #fff; }

    /* Post card */
    .post-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: 1.5rem 1.75rem; border: 1px solid #F1F3F6; }

    .avatar-sm { width: 44px; height: 44px; border-radius: 50%; font-size: .85rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    /* warna avatar bervariasi berdasarkan huruf pertama nama */
    .avatar-sm.c0 { background: #DBEAFE; color: #2563EB; }
    .avatar-sm.c1 { background: #D1FAE5; color: #059669; }
    .avatar-sm.c2 { background: #FDE68A; color: #B45309; }
    .avatar-sm.c3 { background: #FBCFE8; color: #BE185D; }
    .avatar-sm.c4 { background: #E0E7FF; color: #4338CA; }

    .post-author { font-weight: 700; font-size: .95rem; color: #111827; }
    .post-meta { font-size: .8rem; color: #9CA3AF; }

    .post-content { font-size: .95rem; color: #111827; line-height: 1.6; margin-top: .35rem; }

    .icon-action { background: #F3F4F6; border: none; border-radius: 8px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; color: #6B7280; font-size: .9rem; text-decoration: none; transition: background .15s; }
    .icon-action:hover { background: #EEF1F6; color: #111827; }
    .icon-action--danger:hover { background: #FEE2E2; color: #DC2626; }

    .bookmark-btn { background: none; border: none; color: #D1D5DB; font-size: 1.1rem; padding: 0; }
    .bookmark-btn:hover { color: #9CA3AF; }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2 fixed-top">
    <div class="container-fluid p-0">
      <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/">
        <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
      </a>

      <div class="nav-pill-group d-none d-md-flex mx-auto">
        <a href="/student" class="nav-pill-item">
          <i class="bi bi-bar-chart"></i> Dashboard
        </a>
        <a href="/student/feeds" class="nav-pill-item active">
          <i class="bi bi-layers"></i> Social Feed
        </a>
        <a href="/student/profile" class="nav-pill-item">
          <i class="bi bi-journal-bookmark"></i> Profile
        </a>
      </div>

      <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
        <button class="notif-btn" type="button" aria-label="Notifications">
          <i class="bi bi-bell"></i>
          <span class="notif-badge">3</span>
        </button>
        <a href="/student/profile" class="avatar-circle"><%= posts[0].User.name.slice(0,2).toUpperCase()%></a>
      </div>

    </div>
  </nav>

  <!-- Content -->
  <main class="container py-5 mt-5" style="max-width: 680px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h4 class="feed-title mb-1">Social Feed</h4>
        <p class="feed-subtitle mb-0"><%= posts.length %> post tersedia</p>
      </div>
      <% if (!isAdmin) { %>
      <a href="/student/feeds/add" class="btn-add-post">
        <i class="bi bi-plus-lg"></i> Buat Post
      </a>
      <% } %>
    </div>

    <form action="/student/feeds" method="GET" class="mb-4">
  <div class="input-group shadow-sm">
    <span class="input-group-text bg-white border-end-0 text-muted">
      <i class="bi bi-search"></i>
    </span>
    <input 
      type="text" 
      name="search" 
      class="form-control border-start-0 py-2" 
      placeholder="Cari postingan atau tips belajar..." 
      
    >
    <button class="btn btn-primary" type="submit">Cari</button>

  </div>
</form>

    <% if (posts.length === 0) { %>
    <div class="post-card text-center py-5 text-muted">
      <i class="bi bi-chat-square-text fs-2 d-block mb-2"></i>
      Belum ada post. Jadilah yang pertama!
    </div>
    <% } %>

    <% posts.forEach((post, idx) => { %>
    <div class="post-card mb-3">
      <div class="d-flex align-items-start gap-3">
        <span class="avatar-sm c<%= idx % 5 %>">
          <%= post.User && post.User.name ? post.User.name.slice(0,2).toUpperCase() : '??' %>
        </span>
        <div class="flex-grow-1">
          <div class="d-flex align-items-start justify-content-between">
            <div>
              <div class="post-author"><%= post.User ? post.User.name : 'Unknown' %></div>
              <div class="post-meta">
                <%= post.createdAt ? new Date(post.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %>
              </div>
            </div>
            <div class="d-flex align-items-center gap-1">
              <% if (post.userId === sessionUserId || isAdmin) { %>
              <a href="<%= basePath %>/feeds/<%= post.id %>/edit" class="icon-action" title="Edit"><i class="bi bi-pencil"></i></a>
              <form method="POST" action="<%= basePath %>/feeds/<%= post.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus post ini?')">
                <button type="submit" class="icon-action icon-action--danger" title="Hapus"><i class="bi bi-trash"></i></button>
              </form>
              <% } %>
            </div>
          </div>
          <p class="post-content mb-0"><%= post.content %></p>
        </div>
      </div>
    </div>
    <% }) %>
  </main>

</body>
</html>