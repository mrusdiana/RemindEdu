<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — RemindEdu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #F5F7FA; }
    .navbar-brand span { font-weight: 800; }
    .stat-card { background: #fff; border-radius: 14px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,.07); }
    .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .stat-number { font-size: 1.75rem; font-weight: 800; line-height: 1; }
    .stat-caption { font-size: 0.8rem; color: #6B7280; margin-top: 2px; }
    .icon-blue  { background: #EEF4FF; color: #3B82F6; }
    .icon-green { background: #ECFDF5; color: #10B981; }
    .icon-yellow{ background: #FFFBEB; color: #F59E0B; }
    .icon-red   { background: #FEF2F2; color: #EF4444; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand bg-white border-bottom px-4 py-2 shadow-sm">
    <a class="navbar-brand fw-bold" href="/admin">
      <i class="bi bi-mortarboard-fill text-primary me-1"></i>
      Remind<span class="text-primary">Edu</span>
      <span class="badge bg-danger ms-2 fs-6">Admin</span>
    </a>
    <div class="ms-auto d-flex gap-3">
      <a href="/admin/users" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-people"></i> Manage Users
      </a>
      <a href="/admin/feeds" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-layers"></i> Social Feed
      </a>
      <a href="/logout" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-box-arrow-right"></i> Logout
      </a>
    </div>
  </nav>

  <main class="container py-5">
    <div class="mb-4">
      <h4 class="fw-bold mb-1">Admin Dashboard</h4>
      <p class="text-muted mb-0">Ringkasan data seluruh platform RemindEdu.</p>
    </div>

    <div class="row g-3 mb-5">
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card d-flex align-items-center gap-3">
          <div class="stat-icon icon-blue"><i class="bi bi-people-fill"></i></div>
          <div>
            <div class="stat-number"><%= totalUsers %></div>
            <div class="stat-caption">Total Users</div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card d-flex align-items-center gap-3">
          <div class="stat-icon icon-yellow"><i class="bi bi-list-task"></i></div>
          <div>
            <div class="stat-number"><%= totalTasks %></div>
            <div class="stat-caption">Total Tasks</div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card d-flex align-items-center gap-3">
          <div class="stat-icon icon-green"><i class="bi bi-check-circle-fill"></i></div>
          <div>
            <div class="stat-number"><%= completedTasks %></div>
            <div class="stat-caption">Completed Tasks</div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card d-flex align-items-center gap-3">
          <div class="stat-icon icon-red"><i class="bi bi-chat-square-text-fill"></i></div>
          <div>
            <div class="stat-number"><%= totalPosts %></div>
            <div class="stat-caption">Total Posts</div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-md-6">
        <div class="stat-card">
          <h6 class="fw-bold mb-3"><i class="bi bi-people me-1 text-primary"></i> Kelola Pengguna</h6>
          <p class="text-muted small mb-3">Lihat daftar semua user yang terdaftar beserta role mereka.</p>
          <a href="/admin/users" class="btn btn-primary btn-sm">
            <i class="bi bi-arrow-right-circle"></i> Buka Manage Users
          </a>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
