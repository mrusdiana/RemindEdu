<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile — RemindEdu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Inter', sans-serif; background: #F5F7FA; }
    .brand-icon { background: #2F5EFF; color: #fff; border-radius: 10px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .brand-text  { font-weight: 800; font-size: 1.1rem; }
    .text-primary-brand { color: #3B82F6; }
    .nav-pill-group { background: #F3F4F6; border-radius: 999px; padding: 4px; display: flex; gap: 2px; }
    .nav-pill-item { display: flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 999px; font-size: .875rem; font-weight: 500; color: #4B5563; text-decoration: none; transition: background .15s; }
    .nav-pill-item:hover { background: #E5E7EB; color: #111827; }
    .nav-pill-item.active { background: #fff; color: #2563EB; font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.08); }

    .notif-btn { position: relative; background: none; border: none; color: #6B7280; font-size: 1.15rem; width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }
    .notif-btn:hover { background: #F3F4F6; color: #111827; }

    .profile-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.08); overflow: hidden; }
    .profile-cover { height: 130px; background: linear-gradient(120deg, #2563EB 0%, #4F46E5 100%); }
    .profile-body { padding: 0 2rem 2rem; }
    .avatar-circle-lg {
      width: 88px; height: 88px; border-radius: 18px; background: #2563EB; color: #fff;
      font-size: 1.75rem; font-weight: 800; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; border: 4px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,.12);
      margin-top: -44px; position: relative; z-index: 1;
    }
    .avatar-img-lg {
      width: 88px; height: 88px; border-radius: 18px; object-fit: cover;
      border: 4px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,.12);
      margin-top: -44px; position: relative; z-index: 1;
    }

    .info-label { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: #9CA3AF; margin-bottom: 2px; }
    .info-value { font-size: .95rem; font-weight: 500; color: #111827; }
    .role-badge { display: inline-block; padding: 3px 12px; border-radius: 999px; font-size: .75rem; font-weight: 600; }
    .role-student { background: #DBEAFE; color: #1D4ED8; }
    .role-admin   { background: #FEE2E2; color: #B91C1C; }
    .bio-box { background: #F9FAFB; border-radius: 10px; padding: 1rem; font-size: .9rem; color: #374151; min-height: 60px; }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2 fixed-top">
    <div class="container-fluid p-0">
      <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/">
        <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
      </a>

      <div class="nav-pill-group d-none d-md-flex mx-auto">
        <a href="/student" class="nav-pill-item">
          <i class="bi bi-bar-chart"></i> Dashboard
        </a>
        <a href="/student/feeds" class="nav-pill-item">
          <i class="bi bi-layers"></i> Social Feed
        </a>
        <a href="/student/profile" class="nav-pill-item active">
          <i class="bi bi-journal-bookmark"></i> Profile
        </a>
      </div>

      <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
        <a href="/logout" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

  <main class="container py-5 mt-5" style="max-width: 680px;">
    <h4 class="fw-bold mb-4">My Profile</h4>

    <div class="profile-card mb-4">
      <div class="profile-cover"></div>
      <div class="profile-body">
        <% if (user.Profile && user.Profile.avatar) { %>
          <img src="<%= user.Profile.avatar %>" alt="avatar" class="avatar-img-lg">
        <% } else { %>
          <div class="avatar-circle-lg">
            <%= user.name ? user.name.slice(0,2).toUpperCase() : '??' %>
          </div>
        <% } %>

        <div class="mt-3 mb-4">
          <h5 class="fw-bold mb-1"><%= user.name %></h5>
          <span class="role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-student' %>">
            <i class="bi bi-<%= user.role === 'admin' ? 'shield-fill' : 'mortarboard' %> me-1"></i>
            <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
          </span>
        </div>

        <hr class="my-3">

        <div class="row g-3">
          <div class="col-12">
            <div class="info-label">Email</div>
            <div class="info-value"><i class="bi bi-envelope me-1 text-muted"></i><%= user.email %></div>
          </div>
          <div class="col-12">
            <div class="info-label">Bio</div>
            <div class="bio-box">
              <% if (user.Profile && user.Profile.bio) { %>
                <%= user.Profile.bio %>
              <% } else { %>
                <span class="text-muted fst-italic">Belum ada bio.</span>
              <% } %>
            </div>
          </div>
          <div class="col-12">
            <div class="info-label">Member sejak</div>
            <div class="info-value">
              <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a href="/student" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Kembali ke Dashboard
    </a>
  </main>

</body>
</html>