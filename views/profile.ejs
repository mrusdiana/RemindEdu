<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile — RemindEdu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/styles/profile.css">
</head>

<body>
    <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2">
        <div class="container-fluid p-0">

            <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="#">
                <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
                <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
            </a>

            <div class="nav-pill-group d-none d-md-flex mx-auto">
                <a href="dashboards" class="nav-pill-item">
                    <i class="bi bi-bar-chart"></i> Dashboard
                </a>
                <a href="/socialFeeds" class="nav-pill-item">
                    <i class="bi bi-layers"></i> Social Feed
                </a>
                <a href="/profiles" class="nav-pill-item active">
                    <i class="bi bi-journal-bookmark"></i> Profile
                </a>
            </div>

            <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
                <button class="notif-btn" type="button" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notif-badge">3</span>
                </button>
                <span class="avatar-circle">JP</span>
            </div>

        </div>
    </nav>

    <main class="container profile-container py-4 py-md-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                <!-- Profile summary card -->
                <div class="card profile-card border-0 shadow-sm mb-4">
                    <div class="profile-banner"></div>
                    <div class="card-body text-center px-4 pb-4 pt-0">
                        <div class="profile-avatar mx-auto">JP</div>

                        <h3 class="fw-bold mb-1 mt-3">Jordan Park</h3>
                        <p class="text-muted mb-0 small-meta">Computer Science &middot; Year 4</p>
                        <p class="text-muted mb-4 small-meta">University of Technology</p>

                        <hr class="profile-divider">

                        <div class="row text-center pt-3 gx-4">
                            <div class="col-4">
                                <div class="stat-value stat-value--tasks">4</div>
                                <div class="stat-label">Completed Tasks</div>
                            </div>
                            <div class="col-4">
                                <div class="stat-value stat-value--posts">1</div>
                                <div class="stat-label">Posts Shared</div>
                            </div>
                            <div class="col-4">
                                <div class="stat-value stat-value--gpa">3.8</div>
                                <div class="stat-label">GPA</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card courses-card border-0 shadow-sm">
                    <div class="card-body px-4 py-4">
                        <h5 class="fw-bold mb-4">Enrolled Courses</h5>

                        <div class="course-row d-flex align-items-center gap-3">
                            <span class="course-tag tag-orange">CS 301</span>
                            <span class="course-name">Full-Stack Web Development</span>
                        </div>

                        <div class="course-row d-flex align-items-center gap-3">
                            <span class="course-tag tag-blue">MATH 201</span>
                            <span class="course-name">Calculus II</span>
                        </div>

                        <div class="course-row d-flex align-items-center gap-3">
                            <span class="course-tag tag-purple">PHYS 101</span>
                            <span class="course-name">Physics: Mechanics &amp; Waves</span>
                        </div>

                        <div class="course-row d-flex align-items-center gap-3 mb-0">
                            <span class="course-tag tag-green">STAT 220</span>
                            <span class="course-name">Statistical Methods</span>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>

</body>

</html>