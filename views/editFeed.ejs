<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post — RemindEdu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #F5F7FA; }
    .brand-icon { background: #1E40AF; color: #fff; border-radius: 10px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; }
    .brand-text  { font-weight: 800; font-size: 1.1rem; }
    .text-primary-brand { color: #3B82F6; }
    .form-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.08); padding: 2rem; }
    .form-label { font-size: .85rem; font-weight: 600; color: #374151; }
    .form-control:focus { border-color: #3B82F6; box-shadow: 0 0 0 3px rgba(59,130,246,.15); }
    .btn-submit { background: #2563EB; color: #fff; border: none; border-radius: 10px; padding: 10px 24px; font-weight: 600; }
    .btn-submit:hover { background: #1D4ED8; color: #fff; }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand bg-white border-bottom px-3 px-md-4 py-2">
    <div class="container-fluid p-0">
      <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/">
        <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="brand-text">Remind<span class="text-primary-brand">Edu</span></span>
      </a>
      <div class="ms-auto">
        <a href="<%= basePath %>/feeds" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Kembali ke Feed
        </a>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <main class="container py-5" style="max-width: 560px;">
    <h4 class="fw-bold mb-4">Edit Post</h4>

    <div class="form-card">
      <form method="POST" action="<%= basePath %>/feeds/<%= post.id %>/edit">
        <div class="mb-4">
          <label for="content" class="form-label">Konten Post</label>
          <textarea
            id="content"
            name="content"
            class="form-control"
            rows="5"
            required
          ><%= post.content %></textarea>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn-submit">
            <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
          </button>
          <a href="<%= basePath %>/feeds" class="btn btn-outline-secondary">Batal</a>
        </div>
      </form>
    </div>
  </main>

</body>
</html>
